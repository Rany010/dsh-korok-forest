{
  "name": "dsh-korok-forest",
  "version": "0.1.0",
  "private": true,
  "description": "Korok Forest skin for DeepSeek Harness: morning and glow palettes, optional pet, paused seed collection.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "theme",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
